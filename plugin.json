{
  "license": "GPL-3.0-or-later",
  "type": "2110_io",
  "label": "2110_io",
  "runtime": "docker",
  "needs_nic": true,
  "needs_dpdk": true,
  "badge": {
    "label": "MTL",
    "class": "mode-receiver",
    "oklch": "0.76 0.05 220"
  },
  "nmos_role": "both",
  "split_io": true,
  "deploy_order": 0,
  "version": "0.28.4",
  "adapts_input": true,
  "aggregate_fps": false,
  "description": "Receiver ST 2110 via Media Transport Library (MTL/DPDK, kernel-bypass). Réception st20p/st30p écrite en zéro-copie dans le ring shared memory par un binaire C natif (libmtl), exposé en NMOS IS-04/05. Variante haute performance de receiver_2110 (mêmes shm produits). Mode simulation par slot tant que la source n'est pas activée.",
  "nav": {
    "section": "sources",
    "label": "Sources",
    "order": 11
  },
  "script_template": "script.py",
  "control": {
    "endpoints": {
      "gen": {
        "method": "POST",
        "port": 8082,
        "path": "/gen",
        "desc": "Active/désactive la simulation d'un slot (bascule simu↔RX)."
      },
      "ident": {
        "method": "POST",
        "port": 8082,
        "path": "/ident",
        "desc": "Active/désactive et dimensionne l'incrustation IDENT (3 lignes) d'un slot vidéo."
      },
      "gen_tx": {
        "method": "POST",
        "port": 8082,
        "path": "/gen_tx",
        "desc": "Active/désactive le générateur de mire sur un slot TX (sortie)."
      },
      "ident_tx": {
        "method": "POST",
        "port": 8082,
        "path": "/ident_tx",
        "desc": "Active/désactive et dimensionne l'incrustation IDENT incrustée dans le flux 2110 émis (slot TX)."
      },
      "tone_tx": {
        "method": "POST",
        "port": 8082,
        "path": "/tone_tx",
        "desc": "Générateur de tonalité (1 kHz/-18 dBFS, choix des canaux + ruptage) sur un flux audio de sortie TX."
      }
    }
  },
  "ui": {
    "control_html": "control.html",
    "control_js": "control.js",
    "control_css": "control.css"
  },
  "deploy_defaults": {
    "video_count": 25,
    "audio_count": 25,
    "anc_count": 25,
    "tx_count": 25,
    "active_rx_count": 6,
    "active_tx_count": 6,
    "tx_slots": [],
    "smpte_2022_7": false,
    "tx_fallback": "black"
  },
  "config_schema": [
    {
      "key": "smpte_2022_7",
      "type": "bool",
      "label": "SMPTE 2022-7 (dual-path redondant)",
      "default": false
    },
    {
      "key": "tx_fallback",
      "type": "select",
      "label": "Repli TX sans signal (toutes sorties)",
      "options": [
        {
          "value": "none",
          "label": "Coupé"
        },
        {
          "value": "black",
          "label": "Noir + silence"
        },
        {
          "value": "bars",
          "label": "Mire + 1000 Hz"
        }
      ],
      "default": "black"
    }
  ],
  "wiring": {
    "produces": [
      {
        "essence": "video",
        "repeat": "video_count",
        "shm": "{hostname}_{i}"
      },
      {
        "essence": "audio",
        "repeat": "audio_count",
        "shm": "{hostname}_audio_{i}"
      },
      {
        "essence": "data",
        "repeat": "anc_count",
        "shm": "{hostname}_anc_{i}"
      }
    ],
    "consumes": [
      {
        "essence": "video",
        "repeat": "tx_count",
        "label": "Émetteur 2110-20 #{i1}",
        "state_field": "tx{i}_shm"
      },
      {
        "essence": "audio",
        "repeat": "tx_audio_count",
        "label": "Émetteur audio #{i1}",
        "state_field": "tx_audio{i}_shm"
      },
      {
        "essence": "data",
        "repeat": "tx_count",
        "label": "Émetteur ANC #{i1}",
        "state_field": "tx_anc{i}_shm"
      }
    ],
    "mode": "hot-wire",
    "state_endpoint": "/state"
  }
}
